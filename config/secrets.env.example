# Secrets environment variable template
# Documented per 21_project_structure.md §7 and 16_security.md §10
# REAL SECRETS MUST NEVER BE COMMITTED TO VERSION CONTROL.
# Sourced from runtime secrets manager in production.

# Database and Cache
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financial_tracker?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography (16_security.md §4 & §5)
JWT_SECRET=your_jwt_signing_secret_min_32_chars_placeholder
KMS_KEY_ID=arn:aws:kms:region:account-id:key/placeholder-key-id

# Identity Module External Credentials (12_gmail_connector.md §3, 16_security.md §5.1)
GOOGLE_OAUTH_CLIENT_ID=placeholder_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=placeholder_client_secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/v1/oauth/google/callback

# Understanding Module External Credentials (11_ai_blueprint.md §8)
AI_PROVIDER_API_KEY=placeholder_ai_provider_api_key
AI_PROVIDER_BASE_URL=https://api.openai.com/v1

GROQ_PROVIDER_API_KEY=placeholder_ai_provider_api_key
GROQ_PROVIDER_BASE_URL=https://api.groq.com/openai/v1

GEMINI_PROVIDER_API_KEY=placeholder_ai_provider_api_key
GEMINI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OPENROUTER_PROVIDER_API_KEY=placeholder_ai_provider_api_key
# OPENROUTER_PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# Engagement Module External Credentials (15_notification_system.md)
WHATSAPP_API_TOKEN=placeholder_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
