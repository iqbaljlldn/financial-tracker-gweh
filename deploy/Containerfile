# Multi-stage Containerfile for Financial Event Platform
# Specified per 19_deployment.md §4.1 and 21_project_structure.md §3
# Produces minimal, immutable, hardened runtime image running as non-root user

# Stage 1: Build environment
FROM golang:alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod ./
# Copy go.sum if present
COPY go.* ./

RUN go mod download || true

COPY . .

ARG VERSION=dev
ARG COMMIT=none

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION} -X main.Commit=${COMMIT}" \
    -o /bin/platform \
    ./cmd/platform

# Stage 2: Hardened runtime environment
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup

USER 10001:10001

COPY --from=builder /bin/platform /bin/platform

EXPOSE 8080

ENTRYPOINT ["/bin/platform"]
CMD ["--mode=api"]
