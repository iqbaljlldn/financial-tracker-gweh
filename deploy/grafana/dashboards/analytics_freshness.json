      },
      "title": "Projection Lag (p95 / p99) per View",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(analytics_projection_lag_seconds_bucket[5m])) by (le, view_name))",
          "legendFormat": "{{view_name}} (p95)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(analytics_projection_lag_seconds_bucket[5m])) by (le, view_name))",
          "legendFormat": "{{view_name}} (p99)",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
