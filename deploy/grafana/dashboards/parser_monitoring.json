        "tooltip": { "mode": "single" }
      },
      "title": "Template Execution Failures (Falling Back to AI)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "rate(understanding_template_failures_total[5m])",
          "legendFormat": "{{sender_pattern}} - {{reason}}",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
