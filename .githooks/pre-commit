#!/usr/bin/env bash
# Git pre-commit hook for gofmt, goimports, and module-boundary linting
# Enforced per 20_coding_convention.md §5 and §11

set -e

# Find staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    exit 0
fi

echo "Running pre-commit checks on staged Go files..."

# Check formatting with gofmt
UNFORMATTED=$(gofmt -s -l $STAGED_GO_FILES)
if [ -n "$UNFORMATTED" ]; then
    echo "ERROR: The following Go files are not formatted with 'gofmt -s':"
    echo "$UNFORMATTED"
    echo "Please format your files with 'gofmt -s -w <file>' and stage them again."
    exit 1
fi

# Check imports with goimports if installed
if command -v goimports >/dev/null 2>&1; then
    UNFORMATTED_IMPORTS=$(goimports -l $STAGED_GO_FILES)
    if [ -n "$UNFORMATTED_IMPORTS" ]; then
        echo "ERROR: The following Go files have unformatted imports:"
        echo "$UNFORMATTED_IMPORTS"
        echo "Please run 'goimports -w <file>' and stage them again."
        exit 1
    fi
fi

# Run module boundary linter
if [ -d "internal" ]; then
    go run ./cmd/lint-boundaries -dir .
fi

echo "All pre-commit checks passed."
exit 0
